generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------
// Enums
// ------------------------------------------------------

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  WON
  LOST
}

// ------------------------------------------------------
// 1. User Model
// ------------------------------------------------------
model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         Role       @default(ADMIN)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  sessions   Session[]
  leadNotes  LeadNote[]
  auditLogs  AuditLog[]

  @@index([email])
  @@index([role])
}

// ------------------------------------------------------
// 2. Session Model
// ------------------------------------------------------
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

// ------------------------------------------------------
// 3. SiteSettings Model
// ------------------------------------------------------
model SiteSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  category  String   @default("general")
  updatedAt DateTime @updatedAt

  @@index([key])
  @@index([category])
}

// ------------------------------------------------------
// 4. PortfolioCategory Model
// ------------------------------------------------------
model PortfolioCategory {
  id        String             @id @default(cuid())
  slug      String             @unique
  name      String
  sortOrder Int                @default(0)
  projects  PortfolioProject[]

  @@index([slug])
}

// ------------------------------------------------------
// 5. PortfolioTechnology Model
// ------------------------------------------------------
model PortfolioTechnology {
  id       String             @id @default(cuid())
  slug     String             @unique
  name     String
  icon     String?
  projects PortfolioProject[]

  @@index([slug])
}

// ------------------------------------------------------
// 6. PortfolioProject Model
// ------------------------------------------------------
model PortfolioProject {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  client       String
  summary      String
  challenge    String
  solution     String
  results      String[]
  year         String
  liveUrl      String?
  heroImage    String?
  featured     Boolean  @default(false)
  published    Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  categories   PortfolioCategory[]
  technologies PortfolioTechnology[]
  images       PortfolioImage[]

  @@index([slug])
  @@index([featured])
  @@index([published])
  @@index([createdAt])
}

// ------------------------------------------------------
// 7. PortfolioImage Model
// ------------------------------------------------------
model PortfolioImage {
  id        String           @id @default(cuid())
  projectId String
  project   PortfolioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  caption   String?
  sortOrder Int              @default(0)

  @@index([projectId])
}

// ------------------------------------------------------
// 8. Lead Model
// ------------------------------------------------------
model Lead {
  id          String     @id @default(cuid())
  name        String
  company     String?
  phone       String
  email       String
  projectType String
  budget      String
  message     String
  status      LeadStatus @default(NEW)
  assignedTo  String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  notes LeadNote[]

  @@index([status])
  @@index([email])
  @@index([createdAt])
}

// ------------------------------------------------------
// 9. LeadNote Model
// ------------------------------------------------------
model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  text      String
  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([authorId])
}

// ------------------------------------------------------
// 10. Media Model
// ------------------------------------------------------
model Media {
  id        String   @id @default(cuid())
  name      String
  path      String   @unique
  url       String
  mimeType  String
  sizeBytes Int
  alt       String?
  createdAt DateTime @default(now())

  @@index([path])
  @@index([mimeType])
}

// ------------------------------------------------------
// 11. Service Model
// ------------------------------------------------------
model Service {
  id             String           @id @default(cuid())
  slug           String           @unique
  title          String
  priceAmd       String
  priceCurrency  String           @default("AMD")
  showPrice      Boolean          @default(true)
  priceLabel     String?          @default("Starting from")
  popular        Boolean          @default(false)
  tagline        String?
  description    String
  icon           String?
  ctaText        String?          @default("Order Service →")
  seoTitle       String?
  seoDescription String?
  sortOrder      Int              @default(0)
  published      Boolean          @default(true)
  features       ServiceFeature[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([slug])
  @@index([published])
}

// ------------------------------------------------------
// 12. ServiceFeature Model
// ------------------------------------------------------
model ServiceFeature {
  id        String  @id @default(cuid())
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  text      String
  sortOrder Int     @default(0)

  @@index([serviceId])
}

// ------------------------------------------------------
// 13. Testimonial Model
// ------------------------------------------------------
model Testimonial {
  id        String   @id @default(cuid())
  client    String
  company   String
  quote     String
  rating    Int      @default(5)
  avatarUrl String?
  published Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([published])
}

// ------------------------------------------------------
// 14. FAQ Model
// ------------------------------------------------------
model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String   @default("general")
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([category])
  @@index([published])
}

// ------------------------------------------------------
// 15. SeoMetadata Model
// ------------------------------------------------------
model SeoMetadata {
  id          String   @id @default(cuid())
  path        String   @unique
  title       String
  description String
  keywords    String[]
  ogImage     String?
  canonical   String?
  updatedAt   DateTime @updatedAt

  @@index([path])
}

// ------------------------------------------------------
// 16. LegalPage Model
// ------------------------------------------------------
model LegalPage {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  content     String
  lastUpdated String
  published   Boolean  @default(true)
  version     Int      @default(1)
  updatedAt   DateTime @updatedAt

  @@index([slug])
}

// ------------------------------------------------------
// 17. CookieSettings Model
// ------------------------------------------------------
model CookieSettings {
  id                String   @id @default(cuid())
  version           Int      @default(1)
  bannerEnabled     Boolean  @default(true)
  analyticsEnabled  Boolean  @default(true)
  marketingEnabled  Boolean  @default(false)
  gaMeasurementId   String?
  metaPixelId       String?
  updatedAt         DateTime @updatedAt
}

// ------------------------------------------------------
// 18. AuditLog Model
// ------------------------------------------------------
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  resource  String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
