# ==============================================================================
# eLab.am — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' for local development or cPanel NodeJS deployment.
# 2. Fill in production values for your database connection and secrets.
# 3. NEVER commit real passwords, auth secrets, or API keys to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Private Server Secret)
# ------------------------------------------------------------------------------
# PostgreSQL Connection URL format:
# postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
# Compatible with local PostgreSQL, Docker, AWS RDS, Supabase, and cPanel PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/elab_db?schema=public"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY (Private Server Secret)
# ------------------------------------------------------------------------------
# Secret key used for signing session tokens and cryptographic operations.
# Must be a long random string (minimum 16 characters, 32+ recommended).
AUTH_SECRET="eLab_Super_Secret_Auth_Token_32_Bytes_Long_Random_Key"

# Initial super admin password used during database seeding (prisma/seed.ts)
INITIAL_ADMIN_PASSWORD="hello_elab_2026!"

# ------------------------------------------------------------------------------
# 3. CONTACT & EMAIL PROVIDER (Private Server Secrets)
# ------------------------------------------------------------------------------
# Primary recipient email address for contact form inquiries submitted via website
CONTACT_EMAIL="hello@elab.am"

# Optional API Key for email provider (SendGrid, Resend, Mailgun, or SMTP)
EMAIL_PROVIDER_KEY=""

# Optional Webhook URL for forwarding contact form inquiries (Slack/Discord/CRM)
CONTACT_WEBHOOK_URL=""

# ------------------------------------------------------------------------------
# 4. PUBLIC SITE & ANALYTICS (Public Client Variables)
# ------------------------------------------------------------------------------
# Canonical site base URL used for OpenGraph cards, sitemap, and canonical tags
NEXT_PUBLIC_SITE_URL="https://elab.am"

# Optional Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
GOOGLE_ANALYTICS_ID=""

# Optional Meta (Facebook) Pixel ID (e.g. 123456789012345)
META_PIXEL_ID=""

# ------------------------------------------------------------------------------
# 5. ENVIRONMENT MODE
# ------------------------------------------------------------------------------
# Set to 'development' locally or 'production' on deployment server / cPanel
NODE_ENV="development"
